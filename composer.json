{
    "name": "asignua/filament-redirects",
    "description": "A redirect manager with a 404 log for Filament panels: one-hop redirects, a fallback middleware that only touches 404s, multilingual paths and a one-click \"turn this 404 into a redirect\".",
    "keywords": ["filament", "filament-plugin", "laravel", "redirects", "301", "404", "seo", "not-found"],
    "homepage": "https://github.com/asignua/filament-redirects",
    "support": {
        "issues": "https://github.com/asignua/filament-redirects/issues",
        "source": "https://github.com/asignua/filament-redirects"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentRedirects\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentRedirects\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentRedirects\\RedirectsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
